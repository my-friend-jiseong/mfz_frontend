+    MediaStore.setRequireOriginal(sourceUri)
+  } catch (e: Exception) {
+    return sourceUri
+  }
+  return try {
+    contentResolver.openInputStream(original)?.close() ?: return sourceUri
+    original
+  } catch (e: Exception) {
+    sourceUri
+  }
+}
